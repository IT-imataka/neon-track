{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "neon-track",
  "version": "0.1.0",
  "identifier": "com.imataka.neontrack",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
  "macOSPrivateApi": true,
  "windows": [
    {
      "title": "neon-track",
      "width": 720,
      "height": 360,
      "transparent": true,
	    "titleBarStyle": "Overlay",
			"hiddenTitle": true,
      "resizable": false,
      "shadow": false,
			"trafficLightPosition": { "x": 20, "y": 30 }
    }
  ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
